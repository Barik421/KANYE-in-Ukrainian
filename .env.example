VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional local-only fallback for UI work when Supabase is unavailable.
VITE_ENABLE_MOCK_FALLBACK=false

# Local content import/export only. Never expose these in browser code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Used for canonical URLs and sitemap generation.
VITE_SITE_URL=https://example.com

# Google Analytics 4 measurement id, for example G-XXXXXXXXXX.
VITE_GA_MEASUREMENT_ID=

# Optional public Looker Studio / GA dashboard embed URL for the /stats page.
VITE_ANALYTICS_DASHBOARD_URL=

# Static-site contact and support links.
VITE_CONTACT_EMAIL=
VITE_DONATE_URL=

# Use /KANYE-in-Ukrainian/ if deploying to a GitHub Pages project URL without a custom domain.
VITE_BASE_PATH=/
